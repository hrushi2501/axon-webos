{
  "name": "webos-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src test --max-warnings 0",
    "check-types": "tsc --noEmit --project tsconfig.test.json",
    "test": "tsx --test test/server.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.2"
  }
}
