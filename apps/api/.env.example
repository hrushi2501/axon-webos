# Runtime mode and bind address for the Express and WebSocket service.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Comma-separated browser origins allowed to open /ws.
# Production startup fails unless this contains at least one exact HTTP(S) origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Operational limits and structured logging.
MAX_WS_CLIENTS=100
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info

# Set true only behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=false
