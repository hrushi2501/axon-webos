# Optional: enables the Gemini-powered Copilot.
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Per-instance Copilot request protection. Use an edge/distributed limiter at scale.
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=60000

# Optional: required when the API is hosted separately from the frontend.
# NEXT_PUBLIC_API_WS_URL=wss://api.example.com/ws
