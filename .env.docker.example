# Copy to .env for local Docker Compose use. Never commit the resulting .env.
APP_VERSION=local
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=3001

# Browser origins permitted to open the telemetry WebSocket.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_WS_URL=ws://localhost:3001/ws
MAX_WS_CLIENTS=100
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false

# Optional AI Copilot configuration. Set one API key at runtime only.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=60000
