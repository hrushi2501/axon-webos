{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ALLOWED_ORIGINS",
    "APP_VERSION",
    "CHAT_RATE_LIMIT_MAX",
    "CHAT_RATE_LIMIT_WINDOW_MS",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "HOST",
    "LOG_LEVEL",
    "MAX_WS_CLIENTS",
    "NEXT_PUBLIC_API_WS_URL",
    "PORT",
    "SHUTDOWN_TIMEOUT_MS",
    "TRUST_PROXY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
